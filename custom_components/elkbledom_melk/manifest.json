{
  "domain": "elkbledom_melk",
  "name": "ELK-BLEDOM MELK",
  "after_dependencies": ["hassio", "homeassistant"],
  "bluetooth": [
    { "local_name": "ELK-BLEDDM*" },
    { "local_name": "ELK-BULB2*" },
    { "local_name": "ELK-BULB*" },
    { "local_name": "ELK-BLE*" },
    { "local_name": "MELK*" },
    { "local_name": "LEDBLE*" },
    { "local_name": "ELK-LAMPL*" }
  ],
  "codeowners": ["@toragi"],
  "config_flow": true,
  "dependencies": ["bluetooth"],
  "documentation": "https://github.com/toragi/elkbledom-fastlink-melk",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/toragi/elkbledom-fastlink-melk/issues",
  "loggers": ["custom_components.elkbledom_melk"],
  "requirements": [
    "bleak-retry-connector>=3.5.0",
    "bleak>=0.22.2"
  ],
  "version": "1.0.1"
}
