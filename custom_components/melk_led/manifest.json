{
  "domain": "melk_led",
  "name": "MELK LED (Elkotrol-style)",
  "codeowners": ["@toragi"],
  "config_flow": true,
  "dependencies": ["bluetooth"],
  "documentation": "https://github.com/toragi/elkbledom-fastlink-melk",
  "integration_type": "device",
  "iot_class": "local_polling",
  "issue_tracker": "https://github.com/toragi/elkbledom-fastlink-melk/issues",
  "loggers": ["custom_components.melk_led"],
  "requirements": ["bleak-retry-connector>=3.5.0", "bleak>=0.22.2"],
  "version": "1.0.0",
  "bluetooth": [
    { "local_name": "MELK*" },
    { "local_name": "ELK-BLE*" },
    { "local_name": "ELK-BULB*" },
    { "local_name": "LEDBLE*" }
  ]
}
